# Neon: copy the pooled connection string from the Neon dashboard
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me
ADMIN_INVITE_CODE=change-me-too
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Comma-separated list of website origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,https://your-bakery-site.vercel.app
ENVIRONMENT=development
